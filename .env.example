LIVEKIT_API_KEY=<key>
LIVEKIT_API_SECRET=<secret>
AGENT_NAME=
GEMINI_API_KEY=<team token from your card>
GEMINI_BASE_URL=https://james-72765--rtcoach-gemini.modal.run

# Cloud (team/cloud/README.md). The deployed backend needs DATABASE_URL (Supabase > Connect > Transaction pooler URI, with the
# password filled in). The rest are optional: DANCE_PUBLIC_URL is the deployed API's https address (the scorecard QR falls back
# to its board page; Railway fills it from RAILWAY_PUBLIC_DOMAIN), DANCE_LIBRARY_URL a private zip of the AIST keys
# (team/cloud/pack_library.py), JOIN_KEY gates GET /join (?k=) so strangers cannot open rooms, DANCE_CALL_HANDLE the line's
# FaceTime address for the QR. A laptop worker that should use the deployed backend sets BACKEND_URL=https://<api host>.
DATABASE_URL=
DANCE_PUBLIC_URL=
DANCE_LIBRARY_URL=
JOIN_KEY=
DANCE_CALL_HANDLE=
